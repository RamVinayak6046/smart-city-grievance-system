DirectoryIndex index.php index.html

# Prevent direct access to sensitive database files
<FilesMatch "\.(sqlite|sqlite3|sql|log|md|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Allow public access to uploads, assets, and standard web routes
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Security: block hidden files (dotfiles)
    RewriteRule (^\.|/\.) - [F]
</IfModule>
